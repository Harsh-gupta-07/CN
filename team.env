# team.env  -  the ONE file every machine reads (same on both Macs)

# Team identity
TEAM_NAME="jio"
TEAM_ID="jio"
DOMAIN="app.${TEAM_ID}.test"

MAC1_IP="${SERVER_IP}"      # DNS server (dnsmasq)
MAC2_IP="${SERVER_IP}"      # Edge: nginx + load balancer + TLS
MAC3_IP="${SERVER_IP}"      # Backend A  :3001
MAC4_IP="${CLIENT_IP}"      # Backend B  :3002 + test client
DNS_MAC="${SERVER_MAC}"; EDGE_MAC="${SERVER_MAC}"; A_MAC="${SERVER_MAC}"; B_MAC="${CLIENT_MAC}"

# Ports
BACKEND_A_PORT=3001
BACKEND_B_PORT=3002
HTTPS_PORT=8443
HTTP_PORT=8080

# DNS
UPSTREAM_DNS="8.8.8.8"
DNS_TTL=60

# Used only by the "DNS record points to a wrong IP" failure demo
WRONG_IP="${CLIENT_IP}"